NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# These sample credentials are for this local-only Compose setup. Never reuse them outside development.
POSTGRES_DB=nova
POSTGRES_USER=nova_local
POSTGRES_PASSWORD=nova-local-only-change-me
MINIO_ROOT_USER=nova_minio_local
MINIO_ROOT_PASSWORD=nova-minio-only-change-me
DATABASE_URL=postgres://nova_local:nova-local-only-change-me@localhost:5432/nova
# Required in production: each pool applies and validates its restricted role at connection startup.
# DATABASE_ROLE=nova_fastify_runtime
# RATE_LIMIT_DATABASE_ROLE=nova_rate_limiter_runtime
# MEDIA_REVOCATION_DATABASE_ROLE=nova_media_revocation_worker
# Required in production only: stable random key of at least 32 characters; never reuse test keys; rotation resets bucket identity.
# RATE_LIMIT_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Required in production: dedicated least-privilege database principal for rate_limit_buckets.
# RATE_LIMIT_DATABASE_URL=postgres://nova_rate_limiter_login:change-me@localhost:5432/nova
# Required in production: dedicated worker principal limited to reading revocation rows and updating retry metadata.
# MEDIA_REVOCATION_DATABASE_URL=postgres://nova_media_revocation_login:change-me@localhost:5432/nova
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:5173
# Isi dengan alamat/CIDR reverse proxy yang dipercaya, atau biarkan kosong untuk akses langsung.
TRUST_PROXY=
NOINDEX=true
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=nova-api
# S3-compatible storage (MinIO for local development only)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nova-media
S3_ACCESS_KEY_ID=nova_minio_local
S3_SECRET_ACCESS_KEY=nova-minio-only-change-me
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=5242880
UPLOAD_URL_TTL_SECONDS=300
FEEDBACK_RETENTION_DAYS=90
SECURITY_REPORT_RETENTION_DAYS=180
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
